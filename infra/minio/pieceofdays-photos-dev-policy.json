{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PieceOfDaysDevPhotosBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::pieceofdays-photos-dev"]
    },
    {
      "Sid": "PieceOfDaysDevPhotosObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::pieceofdays-photos-dev/photos/*"]
    }
  ]
}
